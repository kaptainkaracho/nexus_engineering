{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @nexus-engineering/frontend build"
  },
  "deploy": {
    "startCommand": "tsx apps/backend/src/index.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "env": {
      "NODE_ENV": "production"
    }
  }
}
