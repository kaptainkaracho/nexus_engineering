FROM node:20-alpine

WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@9.9.2 --activate

COPY apps/backend/package.json apps/backend/tsconfig.json apps/backend/tsconfig.build.json ./apps/backend/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile

COPY apps/backend/src ./apps/backend/src
COPY packages/shared/src ./packages/shared/src
COPY apps/backend/tsconfig.build.json ./apps/backend/tsconfig.build.json
WORKDIR /app/apps/backend
RUN pnpm build

COPY apps/frontend/package.json apps/frontend/vite.config.ts apps/frontend/tsconfig.json ./apps/frontend/
COPY apps/frontend/src ./apps/frontend/src
COPY apps/frontend/index.html ./apps/frontend/
WORKDIR /app/apps/frontend
RUN pnpm build

WORKDIR /app
EXPOSE ${PORT:-3001}

ENV NODE_ENV=production
ENV DATABASE_PATH=/data/nexus.db
ENV PORT=3001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s
  CMD wget --spider -q http://localhost:3001/health || exit 1

CMD ["pnpm", "--filter", "@nexus-engineering/backend", "start"]