# --- Backend (Fastify) ---
PORT=3001
NODE_ENV=development

# SQLite persistence path. In production (Railway) this points at a persistent
# volume mount (/data/nexus.db). Leave unset for an in-memory DB in local dev.
DATABASE_PATH=

# JWT secret for token signing. Generate with: openssl rand -hex 32
# In production, set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY for RS256 signing.
JWT_SECRET=dev-secret-do-not-use-in-production

# Comma-separated allowed CORS origins. Unset = reflect the request origin.
# Not needed for the single-origin Railway deploy (backend serves the SPA).
CORS_ORIGIN=

# --- Self-Hosted Deployment ---
# Set DATABASE_URL for Postgres (e.g. postgres://user:password@postgres:5432/nexus).
# When set, overrides the SQLite DATABASE_PATH.
# Leave unset for SQLite (self-hosted with volume at /data).
DATABASE_URL=
DATABASE_PATH=/data/nexus.db

# Postgres connection (optional — only used when DATABASE_URL is set).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me

# Frontend (Vite)
# Base URL for API calls. Empty => same-origin (/api/...). Only needed when the
# frontend is served from a different origin than the backend.
VITE_API_URL=http://localhost:3001
